# Copy this file to .env and fill in ONE provider.
# The key is only read by the Express server (server/), never sent to the browser.
#
# If no key is set, the app runs in "demo" mode with a built-in mock model
# so `npm install && npm start` always works.

# Provider: gemini | groq | openrouter | openai | ollama | mock
LLM_PROVIDER=gemini

# API key for the chosen provider (not needed for ollama or mock)
LLM_API_KEY=

# Optional: override the model. Defaults per provider are in server/config.js
# LLM_MODEL=

# Optional: override the base URL of any OpenAI-compatible endpoint
# LLM_BASE_URL=

# Optional: per-attempt timeout for the model call, in milliseconds (default 30000)
# LLM_TIMEOUT_MS=30000

# Optional: port for the API server (default 8787)
# PORT=8787
