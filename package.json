{
  "name": "study-assistant",
  "private": true,
  "version": "1.0.0",
  "description": "Paste notes or a topic, get flashcards and a quiz generated by an LLM, then study them interactively.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "concurrently -k -n api,web -c blue,magenta \"npm:server\" \"npm:client\"",
    "dev": "npm start",
    "server": "node --watch-path=server --watch-path=shared server/index.js",
    "server:prod": "node server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "supertest": "^7.3.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
